use seal_topo::layout::{reverse_cuthill_mckee, topology_order, Layout};
use seal_topo::rng::SplitMix64;
use seal_topo::Error;

fn planted(k: usize, size: usize, seed: u64) -> (usize, Vec<(u32, u32)>) {
    let mut rng = SplitMix64::new(seed);
    let n = k * size;
    let mut e = Vec::new();
    for c in 0..k {
        for _ in 0..size * 4 {
            let a = c * size + rng.below(size);
            let b = c * size + rng.below(size);
            e.push((a as u32, b as u32));
        }
    }
    for _ in 0..k * 2 {
        e.push((rng.below(n) as u32, rng.below(n) as u32));
    }
    (n, e)
}

fn is_perm(l: &Layout, n: usize) -> bool {
    let mut seen = vec![false; n];
    l.order.len() == n
        && l.position.len() == n
        && l.communities.len() == n
        && l.order.iter().all(|&x| {
            let ok = (x as usize) < n && !seen[x as usize];
            if ok {
                seen[x as usize] = true;
            }
            ok
        })
        && (0..n).all(|p| l.position[l.order[p] as usize] as usize == p)
}

#[test]
fn valid_permutation_on_random_graphs() {
    for seed in 0..10 {
        let (n, e) = planted(5, 30, seed);
        let l = topology_order(n, &e, None).unwrap();
        assert!(is_perm(&l, n), "seed {seed}");
    }
}

#[test]
fn identical_across_8_runs() {
    let (n, e) = planted(6, 40, 1);
    let base = topology_order(n, &e, None).unwrap();
    for _ in 0..8 {
        assert_eq!(topology_order(n, &e, None).unwrap(), base);
    }
}

#[test]
fn identical_across_rayon_and_std_thread_counts() {
    let (n, e) = planted(6, 40, 2);
    let base = topology_order(n, &e, None).unwrap();
    for t in [1usize, 2, 4, 8] {
        let pool = rayon::ThreadPoolBuilder::new()
            .num_threads(t)
            .build()
            .unwrap();
        let got = pool.install(|| topology_order(n, &e, None).unwrap());
        assert_eq!(got, base, "rayon threads {t}");
    }
    let hs: Vec<_> = (0..8)
        .map(|_| {
            let e = e.clone();
            std::thread::spawn(move || topology_order(n, &e, None).unwrap())
        })
        .collect();
    for h in hs {
        assert_eq!(h.join().unwrap(), base);
    }
}

#[test]
fn isomorphic_relabelling_with_stable_ids_gives_the_same_layout() {
    let (n, e) = planted(5, 35, 3);
    let ids: Vec<u64> = (0..n as u64).map(|i| i * 11 + 5).collect();
    let base = topology_order(n, &e, Some(&ids)).unwrap();
    let mut rng = SplitMix64::new(77);
    for _ in 0..5 {
        let mut pi: Vec<usize> = (0..n).collect();
        rng.shuffle(&mut pi);
        let mut ids2 = vec![0u64; n];
        for u in 0..n {
            ids2[pi[u]] = ids[u];
        }
        let mut e2: Vec<(u32, u32)> = e
            .iter()
            .map(|&(a, b)| {
                let (a, b) = (pi[a as usize] as u32, pi[b as usize] as u32);
                if rng.below(2) == 0 {
                    (a, b)
                } else {
                    (b, a)
                }
            })
            .collect();
        rng.shuffle(&mut e2);
        let l2 = topology_order(n, &e2, Some(&ids2)).unwrap();
        let a: Vec<u64> = base.order.iter().map(|&u| ids[u as usize]).collect();
        let b: Vec<u64> = l2.order.iter().map(|&u| ids2[u as usize]).collect();
        assert_eq!(a, b);
    }
}

#[test]
fn degenerate_graphs() {
    let l = topology_order(0, &[], None).unwrap();
    assert!(l.order.is_empty() && l.position.is_empty());
    assert_eq!(topology_order(1, &[], None).unwrap().order, vec![0]);
    assert_eq!(topology_order(1, &[(0, 0)], None).unwrap().order, vec![0]);
    let l = topology_order(5, &[], None).unwrap();
    assert!(is_perm(&l, 5));
    let e = [(0, 1), (1, 2), (0, 2), (3, 4), (4, 5), (3, 5)];
    let l = topology_order(7, &e, None).unwrap();
    assert!(is_perm(&l, 7));
    let mut head: Vec<u32> = l.order[..3].to_vec();
    head.sort();
    assert_eq!(head, vec![0, 1, 2]);
    let e = [(0, 0), (0, 1), (0, 1), (1, 0), (1, 2), (2, 2), (2, 2)];
    let l = topology_order(3, &e, None).unwrap();
    assert!(is_perm(&l, 3));
    assert!(matches!(
        topology_order(3, &[(0, 3)], None),
        Err(Error::OutOfRange(_))
    ));
    assert!(matches!(
        topology_order(2, &[], Some(&[7, 7])),
        Err(Error::DuplicateId(7))
    ));
    assert!(matches!(
        topology_order(2, &[], Some(&[7])),
        Err(Error::Shape(_))
    ));
}

#[test]
fn communities_are_contiguous_and_ordered_by_smallest_id() {
    let a: Vec<u32> = vec![0, 2, 4, 6, 8, 10];
    let b: Vec<u32> = vec![1, 3, 5, 7, 9, 11];
    let mut e = Vec::new();
    for g in [&a, &b] {
        for i in 0..6 {
            for j in i + 1..6 {
                e.push((g[i], g[j]));
            }
        }
    }
    e.push((10, 1));
    let l = topology_order(12, &e, None).unwrap();
    assert!(is_perm(&l, 12));
    let first: std::collections::BTreeSet<u32> = l.order[..6].iter().copied().collect();
    let second: std::collections::BTreeSet<u32> = l.order[6..].iter().copied().collect();
    let sa: std::collections::BTreeSet<u32> = a.iter().copied().collect();
    let sb: std::collections::BTreeSet<u32> = b.iter().copied().collect();
    assert_eq!(first, sa, "community holding node 0 comes first");
    assert_eq!(second, sb);
    assert_eq!(l.communities[0], 0);
    assert_eq!(l.communities[1], 1);
}

#[test]
fn rcm_hand_computed_path_and_star() {
    let path = [(0, 1), (1, 2), (2, 3), (3, 4)];
    assert_eq!(
        reverse_cuthill_mckee(5, &path, None).unwrap(),
        vec![4, 3, 2, 1, 0]
    );
    let p2 = [(2, 0), (0, 3), (3, 1)];
    assert_eq!(
        reverse_cuthill_mckee(4, &p2, None).unwrap(),
        vec![2, 0, 3, 1]
    );
    let star = [(0, 1), (0, 2), (0, 3), (0, 4)];
    assert_eq!(
        reverse_cuthill_mckee(5, &star, None).unwrap(),
        vec![4, 3, 2, 0, 1]
    );
}

#[test]
fn rcm_visits_low_degree_neighbours_first_hand_computed() {
    let e = [(0, 1), (0, 2), (1, 3), (1, 4), (2, 5)];
    assert_eq!(
        reverse_cuthill_mckee(6, &e, None).unwrap(),
        vec![5, 2, 0, 4, 1, 3]
    );
}

fn bandwidth(n: usize, e: &[(u32, u32)], order: &[u32]) -> usize {
    let mut pos = vec![0usize; n];
    for (p, &u) in order.iter().enumerate() {
        pos[u as usize] = p;
    }
    e.iter()
        .map(|&(a, b)| pos[a as usize].abs_diff(pos[b as usize]))
        .max()
        .unwrap_or(0)
}

#[test]
fn rcm_reduces_bandwidth_of_a_shuffled_grid() {
    let w = 20usize;
    let n = w * w;
    let mut rng = SplitMix64::new(5);
    let mut label: Vec<u32> = (0..n as u32).collect();
    rng.shuffle(&mut label);
    let mut e = Vec::new();
    for y in 0..w {
        for x in 0..w {
            let u = label[y * w + x];
            if x + 1 < w {
                e.push((u, label[y * w + x + 1]));
            }
            if y + 1 < w {
                e.push((u, label[(y + 1) * w + x]));
            }
        }
    }
    let ident: Vec<u32> = (0..n as u32).collect();
    let before = bandwidth(n, &e, &ident);
    let order = reverse_cuthill_mckee(n, &e, None).unwrap();
    let after = bandwidth(n, &e, &order);
    assert!(after * 5 < before, "bandwidth {before} -> {after}");
    assert!(after <= 2 * w);
}

#[test]
fn query_results_identical_sorted_vs_unsorted() {
    let (n, e) = planted(4, 50, 9);
    let l = topology_order(n, &e, None).unwrap();
    let hop2 = |edges: &[(u32, u32)]| -> Vec<usize> {
        let mut adj = vec![Vec::new(); n];
        for &(a, b) in edges {
            adj[a as usize].push(b as usize);
            adj[b as usize].push(a as usize);
        }
        (0..n)
            .map(|s| {
                let mut seen = std::collections::BTreeSet::new();
                seen.insert(s);
                let mut front = vec![s];
                for _ in 0..2 {
                    let mut next = Vec::new();
                    for &u in &front {
                        for &v in &adj[u] {
                            if seen.insert(v) {
                                next.push(v);
                            }
                        }
                    }
                    front = next;
                }
                seen.len()
            })
            .collect()
    };
    let before = hop2(&e);
    let e2: Vec<(u32, u32)> = e
        .iter()
        .map(|&(a, b)| (l.position[a as usize], l.position[b as usize]))
        .collect();
    let after = hop2(&e2);
    for u in 0..n {
        assert_eq!(before[u], after[l.position[u] as usize], "node {u}");
    }
}
