//! Minimum spanning tree, random walks, maximum flow.
#![allow(clippy::needless_range_loop)]

use seal_algo::{
    component_count, kruskal_mst, max_flow, prim_mst, random_walk, random_walks,
    weakly_connected_components, Error, Projection, RandomWalkConfig, XorShift64,
};

mod common;
use common::{approx, karate, random_edges};

/// CLRS fig. 23.4: a..i = 0..8, MST weight 37.
fn clrs_mst() -> Projection {
    Projection::from_weighted_edges(
        9,
        &[
            (0, 1, 4.0),
            (0, 7, 8.0),
            (1, 2, 8.0),
            (1, 7, 11.0),
            (2, 3, 7.0),
            (2, 5, 4.0),
            (2, 8, 2.0),
            (3, 4, 9.0),
            (3, 5, 14.0),
            (4, 5, 10.0),
            (5, 6, 2.0),
            (6, 7, 1.0),
            (6, 8, 6.0),
            (7, 8, 7.0),
        ],
        false,
    )
    .unwrap()
}

#[test]
fn kruskal_and_prim_agree_on_the_textbook_graph() {
    let k = kruskal_mst(&clrs_mst());
    assert_eq!(k.total_weight, 37.0);
    assert_eq!(k.edges.len(), 8);
    assert_eq!(k.components, 1);
    let p = prim_mst(&clrs_mst(), 0).unwrap();
    assert_eq!(p.total_weight, 37.0);
    assert_eq!(p.edges.len(), 8);
    assert_eq!(prim_mst(&clrs_mst(), 5).unwrap().total_weight, 37.0);
}

#[test]
fn spanning_forest_of_a_disconnected_graph() {
    let g = Projection::from_weighted_edges(
        6,
        &[(0, 1, 2.0), (1, 2, 3.0), (0, 2, 1.0), (3, 4, 5.0)],
        false,
    )
    .unwrap();
    let k = kruskal_mst(&g);
    assert_eq!((k.edges.len(), k.components, k.total_weight), (3, 3, 8.0));
    let p = prim_mst(&g, 0).unwrap();
    assert_eq!((p.edges.len(), p.components, p.total_weight), (2, 1, 3.0));
}

#[test]
fn spanning_tree_ignores_loops_picks_lightest_parallel_edge_and_direction() {
    let g = Projection::from_weighted_edges(
        3,
        &[(0, 0, 0.1), (0, 1, 9.0), (1, 0, 2.0), (2, 1, 3.0)],
        true,
    )
    .unwrap();
    let k = kruskal_mst(&g);
    assert_eq!(k.total_weight, 5.0);
    assert_eq!(k.edges.len(), 2);
    assert!(k.edges.iter().all(|&(u, v, _)| u < v));
    assert_eq!(prim_mst(&g, 2).unwrap().total_weight, 5.0);
}

#[test]
fn spanning_tree_edge_cases() {
    let g = Projection::from_edges(0, &[], false).unwrap();
    let k = kruskal_mst(&g);
    assert!(k.edges.is_empty());
    assert_eq!((k.components, k.total_weight), (0, 0.0));
    assert!(matches!(prim_mst(&g, 0), Err(Error::NodeOutOfRange { .. })));
    let g = Projection::from_edges(1, &[], false).unwrap();
    assert_eq!(kruskal_mst(&g).components, 1);
    assert_eq!(prim_mst(&g, 0).unwrap().edges.len(), 0);
    // unweighted: every edge costs 1, so the weight is the edge count of the forest
    assert_eq!(kruskal_mst(&karate()).total_weight, 33.0);
}

/// Largest edge weight on the tree path u..v, via DFS over the tree edges.
fn max_on_tree_path(n: usize, tree: &[(u32, u32, f64)], u: u32, v: u32) -> Option<f64> {
    let mut adj = vec![Vec::new(); n];
    for &(a, b, w) in tree {
        adj[a as usize].push((b, w));
        adj[b as usize].push((a, w));
    }
    let mut best = vec![None; n];
    best[u as usize] = Some(f64::NEG_INFINITY);
    let mut stack = vec![u];
    while let Some(x) = stack.pop() {
        let bx: f64 = best[x as usize].unwrap();
        for &(y, w) in &adj[x as usize] {
            if best[y as usize].is_none() {
                best[y as usize] = Some(bx.max(w));
                stack.push(y);
            }
        }
    }
    best[v as usize]
}

#[test]
fn mst_certified_by_cycle_property_and_prim_matches_kruskal() {
    let mut rng = XorShift64::new(515);
    for case in 0..100 {
        let n = 2 + rng.gen_range(25) as usize;
        let m = rng.gen_range(4 * n as u64) as usize;
        let edges = random_edges(&mut rng, n as u32, m, 0.0, 10.0);
        let g = Projection::from_weighted_edges(n, &edges, case % 2 == 0).unwrap();
        let k = kruskal_mst(&g);
        let comps = component_count(&weakly_connected_components(&g));
        assert_eq!(k.components, comps, "case {case}");
        assert_eq!(k.edges.len(), n - comps, "case {case}");
        assert!(approx(
            k.total_weight,
            k.edges.iter().map(|e| e.2).sum(),
            1e-9
        ));
        // cycle property: no non-tree edge is lighter than the heaviest tree edge on its cycle
        for &(u, v, w) in &edges {
            if u != v {
                let top = max_on_tree_path(n, &k.edges, u, v).expect("endpoints share a component");
                assert!(
                    w >= top - 1e-12,
                    "case {case}: edge ({u},{v},{w}) beats tree path max {top}"
                );
            }
        }
        // Prim from the first node of every component reaches the same total
        let wcc = weakly_connected_components(&g);
        let mut prim_total = 0.0;
        for root in (0..n as u32).filter(|&u| wcc[u as usize] == u) {
            prim_total += prim_mst(&g, root).unwrap().total_weight;
        }
        assert!(approx(prim_total, k.total_weight, 1e-9), "case {case}");
    }
}

#[test]
fn random_walk_follows_arcs_and_stops_at_dead_ends() {
    let g = Projection::from_edges(3, &[(0, 1), (1, 2)], true).unwrap();
    let mut rng = XorShift64::new(1);
    assert_eq!(
        random_walk(&g, 0, 10, &mut rng, false).unwrap(),
        vec![0, 1, 2]
    );
    assert_eq!(random_walk(&g, 0, 0, &mut rng, false).unwrap(), vec![0]);
    assert_eq!(random_walk(&g, 2, 5, &mut rng, false).unwrap(), vec![2]);
    assert!(matches!(
        random_walk(&g, 7, 5, &mut rng, false),
        Err(Error::NodeOutOfRange { .. })
    ));
}

#[test]
fn random_walk_is_seeded_and_every_step_is_an_arc() {
    let g = karate();
    let walk = |seed| random_walk(&g, 0, 200, &mut XorShift64::new(seed), false).unwrap();
    let a = walk(4);
    assert_eq!(a.len(), 201);
    assert_eq!(a, walk(4));
    assert_ne!(a, walk(5));
    assert!(a.windows(2).all(|w| g.has_edge(w[0], w[1])));
}

#[test]
fn random_walk_step_distribution_uniform_and_weighted() {
    let star = Projection::from_edges(4, &[(0, 1), (0, 2), (0, 3)], true).unwrap();
    let mut rng = XorShift64::new(2);
    let mut hits = [0u32; 4];
    for _ in 0..6000 {
        hits[random_walk(&star, 0, 1, &mut rng, false).unwrap()[1] as usize] += 1;
    }
    for &h in &hits[1..] {
        assert!((1800..2200).contains(&h), "{hits:?}");
    }
    let g = Projection::from_weighted_edges(3, &[(0, 1, 9.0), (0, 2, 1.0)], true).unwrap();
    let ones = (0..5000)
        .filter(|_| random_walk(&g, 0, 1, &mut rng, true).unwrap()[1] == 1)
        .count();
    assert!((4400..4600).contains(&ones), "{ones}");
    let neg = Projection::from_weighted_edges(2, &[(0, 1, -1.0)], true).unwrap();
    assert!(matches!(
        random_walk(&neg, 0, 1, &mut rng, true),
        Err(Error::InvalidParameter(_))
    ));
}

#[test]
fn random_walks_cover_every_start_node_deterministically() {
    let g = karate();
    let cfg = RandomWalkConfig {
        walk_length: 10,
        walks_per_node: 3,
        seed: 6,
        weighted: false,
    };
    let w = random_walks(&g, &cfg).unwrap();
    assert_eq!(w.len(), 34 * 3);
    for (i, walk) in w.iter().enumerate() {
        assert_eq!(walk[0] as usize, i / 3);
        assert_eq!(walk.len(), 11);
    }
    assert_eq!(w, random_walks(&g, &cfg).unwrap());
    let d = RandomWalkConfig::default();
    assert_eq!((d.walk_length, d.walks_per_node), (80, 10));
}

/// CLRS fig. 26.6: s=0 v1=1 v2=2 v3=3 v4=4 t=5, max flow 23.
fn clrs_flow() -> Projection {
    Projection::from_weighted_edges(
        6,
        &[
            (0, 1, 16.0),
            (0, 2, 13.0),
            (1, 3, 12.0),
            (2, 1, 4.0),
            (2, 4, 14.0),
            (3, 2, 9.0),
            (3, 5, 20.0),
            (4, 3, 7.0),
            (4, 5, 4.0),
        ],
        true,
    )
    .unwrap()
}

/// Sum of capacity over arcs from the source side to the sink side.
fn cut_capacity(g: &Projection, side: &[bool]) -> f64 {
    let mut c = 0.0;
    for u in 0..g.node_count() as u32 {
        for (v, w) in g.out_edges(u) {
            if side[u as usize] && !side[v as usize] {
                c += w;
            }
        }
    }
    c
}

fn check_flow_feasible(g: &Projection, s: u32, t: u32, flows: &[f64], value: f64) {
    let n = g.node_count();
    let mut net = vec![0.0f64; n];
    let mut idx = 0;
    for u in 0..n as u32 {
        for (v, cap) in g.out_edges(u) {
            let f = flows[idx];
            idx += 1;
            assert!(f >= -1e-9 && f <= cap + 1e-9, "flow {f} outside [0, {cap}]");
            net[u as usize] -= f;
            net[v as usize] += f;
        }
    }
    assert_eq!(idx, flows.len());
    for u in 0..n {
        if u as u32 != s && u as u32 != t {
            assert!(
                net[u].abs() < 1e-9,
                "conservation violated at {u}: {}",
                net[u]
            );
        }
    }
    assert!(approx(-net[s as usize], value, 1e-9));
    assert!(approx(net[t as usize], value, 1e-9));
}

#[test]
fn dinic_textbook_network() {
    let g = clrs_flow();
    let f = max_flow(&g, 0, 5).unwrap();
    assert_eq!(f.value, 23.0);
    assert_eq!(cut_capacity(&g, &f.source_side), 23.0);
    assert!(f.source_side[0] && !f.source_side[5]);
    check_flow_feasible(&g, 0, 5, &f.arc_flows, f.value);
}

#[test]
fn dinic_small_cases() {
    let par = Projection::from_weighted_edges(2, &[(0, 1, 3.0), (0, 1, 4.0), (1, 1, 100.0)], true)
        .unwrap();
    assert_eq!(max_flow(&par, 0, 1).unwrap().value, 7.0);
    let none = Projection::from_weighted_edges(3, &[(0, 1, 3.0)], true).unwrap();
    let f = max_flow(&none, 0, 2).unwrap();
    assert_eq!(f.value, 0.0);
    assert!(f.source_side[0] && f.source_side[1] && !f.source_side[2]);
    let frac = Projection::from_weighted_edges(
        4,
        &[(0, 1, 0.5), (0, 2, 0.25), (1, 3, 0.75), (2, 3, 0.25)],
        true,
    )
    .unwrap();
    assert!(approx(max_flow(&frac, 0, 3).unwrap().value, 0.75, 1e-12));
    let undirected =
        Projection::from_weighted_edges(3, &[(0, 1, 5.0), (1, 2, 3.0)], false).unwrap();
    assert_eq!(max_flow(&undirected, 0, 2).unwrap().value, 3.0);
    assert_eq!(max_flow(&undirected, 2, 0).unwrap().value, 3.0);
}

#[test]
fn dinic_unweighted_bipartite_matching() {
    // s=0, left 1..=3, right 4..=6, t=7; left i can match right i and i+1 (mod 3)
    let mut e = vec![];
    for l in 0..3u32 {
        e.push((0, 1 + l));
        e.push((4 + l, 7));
        e.push((1 + l, 4 + l));
        e.push((1 + l, 4 + (l + 1) % 3));
    }
    let g = Projection::from_edges(8, &e, true).unwrap();
    assert_eq!(max_flow(&g, 0, 7).unwrap().value, 3.0);
}

#[test]
fn dinic_validates_input() {
    let g = clrs_flow();
    assert!(matches!(
        max_flow(&g, 0, 0),
        Err(Error::InvalidParameter(_))
    ));
    assert!(matches!(
        max_flow(&g, 0, 99),
        Err(Error::NodeOutOfRange { .. })
    ));
    let neg = Projection::from_weighted_edges(2, &[(0, 1, -1.0)], true).unwrap();
    assert!(matches!(
        max_flow(&neg, 0, 1),
        Err(Error::NegativeWeight { .. })
    ));
}

#[test]
fn dinic_equals_brute_force_min_cut_on_random_networks() {
    let mut rng = XorShift64::new(777);
    for case in 0..200 {
        let n = 3 + rng.gen_range(8) as usize;
        let m = rng.gen_range(5 * n as u64) as usize;
        let edges: Vec<_> = random_edges(&mut rng, n as u32, m, 1.0, 10.0)
            .into_iter()
            .map(|(u, v, w)| (u, v, w.floor()))
            .collect();
        let g = Projection::from_weighted_edges(n, &edges, case % 3 != 0).unwrap();
        let (s, t) = (0u32, n as u32 - 1);
        let f = max_flow(&g, s, t).unwrap();
        // enumerate every s-t cut
        let mut best = f64::INFINITY;
        for mask in 0..(1u32 << n) {
            if mask & 1 == 1 && mask >> (n - 1) & 1 == 0 {
                let side: Vec<bool> = (0..n).map(|i| mask >> i & 1 == 1).collect();
                best = best.min(cut_capacity(&g, &side));
            }
        }
        assert!(
            approx(f.value, best, 1e-9),
            "case {case}: flow {} vs min cut {best}",
            f.value
        );
        assert!(
            approx(cut_capacity(&g, &f.source_side), f.value, 1e-9),
            "case {case}: reported cut"
        );
        check_flow_feasible(&g, s, t, &f.arc_flows, f.value);
    }
}
