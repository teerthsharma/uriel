    "ON",
    "AND",
    "OR",
    "XOR",
    "NOT",
    "IN",
    "IS",
    "NULL",
    "CASE",
    "WHEN",
    "THEN",
    "ELSE",
    "END",
    "STARTS",
    "ENDS",
    "CONTAINS",
    "EXISTS",
    "DISTINCT",
    "INDEX",
    "CONSTRAINT",
    "FOR",
    "REQUIRE",
    "UNIQUE",
    "SHOW",
    "DROP",
    "EXPLAIN",
    "n",
    "m",
    "x",
    "Person",
    "name",
    "count",
    "(",
    ")",
    "[",
    "]",
    "{",
    "}",
    "-",
    "->",
    "<-",
    "--",
    "-->",
    "<--",
    ":",
    ",",
    ".",
    "..",
    "|",
    "*",
    "+",
    "=",
    "<>",
    "<=",
    ">=",
    "=~",
    "+=",
    "$p",
    "1",
    "2.5",
    "'s'",
    "\"d\"",
    "`b`",
    "0x1F",
    "^",
    "%",
    "/",
    ";",
    "//",
    "/*",
    "*/",
];

#[test]
fn fuzz_random_bytes_5000() {
    run_bounded(|| {
        let mut rng = Lcg(0x5EED_CAFE);
        for _ in 0..5000 {
            let len = rng.below(97);
            let bytes: Vec<u8> = (0..len).map(|_| rng.next() as u8).collect();
            let text = String::from_utf8_lossy(&bytes).into_owned();
            check(&text);
        }
    });
}

#[test]
fn fuzz_ascii_punctuation_5000() {
    run_bounded(|| {
        let alphabet: Vec<char> = "()[]{}<>-=+*/%^|:;,.$'\"`\\ \n\tabcnxMTRCE0123456789_~!@#&?"
            .chars()
            .collect();
        let mut rng = Lcg(42);
        for _ in 0..5000 {
            let len = rng.below(60);
            let text: String = (0..len)
                .map(|_| alphabet[rng.below(alphabet.len())])
                .collect();
            check(&text);
        }
    });
}

#[test]
fn fuzz_token_soup_5000() {
    run_bounded(|| {
        let mut rng = Lcg(7);
        for _ in 0..5000 {
            let n = 1 + rng.below(24);
            let text = (0..n)
                .map(|_| WORDS[rng.below(WORDS.len())])
                .collect::<Vec<_>>()
                .join(" ");
            check(&text);
        }
    });
}

#[test]
fn fuzz_mutated_valid_queries_5000() {
    run_bounded(|| {
        let mut rng = Lcg(2024);
        for _ in 0..5000 {
            let seed = SEEDS[rng.below(SEEDS.len())];
            let mut chars: Vec<char> = seed.chars().collect();
            for _ in 0..1 + rng.below(4) {
                if chars.is_empty() {
                    break;
                }
                let at = rng.below(chars.len());
                match rng.below(4) {
                    0 => {
                        chars.remove(at);
                    }
                    1 => chars.insert(at, char::from(32 + (rng.next() % 95) as u8)),
                    2 => chars.truncate(at),
                    _ => {
                        let w = WORDS[rng.below(WORDS.len())];
                        for (i, c) in w.chars().enumerate() {
                            chars.insert(at + i, c);
                        }
                    }
                }
            }
            let text: String = chars.into_iter().collect();
            check(&text);
        }
    });
}

#[test]
fn fuzz_seeds_themselves_parse_and_round_trip() {
    for seed in SEEDS {
        let q = parse(seed).unwrap_or_else(|e| panic!("{seed}: {e}"));
        assert_eq!(parse(&q.to_string()).unwrap(), q, "{seed}");
    }
}

#[test]
fn fuzz_every_prefix_of_every_seed_terminates() {
    run_bounded(|| {
        for seed in SEEDS {
            let mut ends: Vec<usize> = seed.char_indices().map(|(i, _)| i).collect();
            ends.push(seed.len());
            for end in ends {
                check(&seed[..end]);
            }
        }
    });
}
